# /etc/caddy/Caddyfile on the VPS. reader.balu.party is proxied by Cloudflare (SSL mode "Full (strict)"),
# and deploy/cloudflare-only.sh limits ports 80/443 to Cloudflare. Caddy still gets and renews its own
# Let's Encrypt certificate over port 80, through the proxy.
{
	servers {
		# shortcut: Cloudflare's ranges are copied in (cloudflare.com/ips), refresh if they ever change
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

reader.balu.party {
	encode zstd gzip
	request_body {
		max_size 100MB
	}
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy localhost:8095 {
		# the visitor's address (not Cloudflare's), for sign-in throttling
		header_up X-Real-IP {client_ip}
	}
}
